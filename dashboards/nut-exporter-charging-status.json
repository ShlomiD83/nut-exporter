  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "title": "Exporter on GitHub",
      "type": "link",
      "url": "https://github.com/ShlomiD83/nut-exporter",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": []
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 13,
      "type": "stat",
      "title": "Status",
      "description": "Online with battery charge below 100% is shown as Charging. On battery and Low battery retain their UPS status.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unknown"
                },
                "1": {
                  "text": "Online"
                },
                "2": {
                  "text": "On battery"
                },
                "3": {
                  "text": "Low battery"
                },
                "4": {
                  "text": "Charging"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "dark-green"
              },
              {
                "value": 2,
                "color": "orange"
              },
              {
                "value": 3,
                "color": "red"
              },
              {
                "value": 4,
                "color": "semi-dark-yellow"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "text": {},
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.2.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "exemplar": true,
          "expr": "nut_status{ups=~\"${ups:pipe}\"} + (nut_status{ups=~\"${ups:pipe}\"} == bool 1) * (nut_battery_charge{ups=~\"${ups:pipe}\"} < bool 1) * 3",
          "instant": true,
          "interval": "",
          "legendFormat": "{{ups}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "marcusolsson-dynamictext-panel",
      "title": "Runtime",
      "description": "Total minutes:seconds from NUT battery runtime. Requires Grafana Business Text plugin.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "dark-green"
              },
              {
                "value": 80,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "afterRender": "",
        "content": "<div style=\"width:100%;height:100%;box-sizing:border-box;display:flex;align-items:flex-end;justify-content:center;padding-bottom:18px;container-type:inline-size;overflow:hidden;line-height:1;color:#37872D\"><span style=\"display:block;transform:translateY(18px);font-size:clamp(40px,20cqw,80px);font-weight:500;font-variant-numeric:tabular-nums;line-height:1;white-space:nowrap\">{{runtimeClock}}</span></div>",
        "contentPartials": [],
        "defaultContent": "No data",
        "editor": {
          "format": "auto",
          "language": "markdown"
        },
        "editors": [],
        "externalStyles": [],
        "helpers": "context.handlebars.registerHelper('runtimeClock', () => {\n  const frames = context.panelData?.series ?? context.panel?.panelData?.series ?? (context.dataFrame ? [context.dataFrame] : []);\n  const frame = frames.find(f => f.fields?.some(field => field.type === 'number'));\n  const field = frame?.fields?.find(f => f.type === 'number');\n  const values = field?.values;\n  const raw = values == null ? NaN : (typeof values.get === 'function' ? values.get(values.length - 1) : values[values.length - 1]);\n  const seconds = Math.max(0, Math.floor(Number(raw)));\n  return Number.isFinite(Number(raw)) ? `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}` : '—';\n});",
        "renderMode": "allRows",
        "styles": "html, body { margin: 0; overflow: hidden !important; }",
        "wrap": "none"
      },
      "pluginVersion": "6.3.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "exemplar": true,
          "expr": "nut_battery_runtime_seconds{ups=~\"${ups:pipe}\"}",
          "instant": true,
          "interval": "",
          "legendFormat": "{{ups}}"
        }
      ]
    },
